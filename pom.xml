<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 3.5.14 → 3.5.16 (LFPT-0725). Подтягивает исправленные:
             - Spring Framework 6.2.19 (XSS в JavaScriptUtils, DoS через SpEL/versioned resources,
               Open Redirect, multipart smuggling, предсказуемый session id WebSocket)
             - Spring Security 6.5.11 (Open Redirect через CookieRequestCache)
             - Spring Data 2025.0.13 (исчерпание heap через кэш property path)
             - Spring Boot: SSL hostname verification в Mail auto-config (CVE-2026-40992)
             - Micrometer 1.15.12 (DoS), Logback 1.5.34, Thymeleaf 3.1.5 (CVE-2026-41901, SSTI)
             Не закрыты в 6.2.x (фикс только в Spring 7.0.9), к проекту неприменимы — не используем
             SseEmitter/FragmentsRendering и XsltView: CVE-2026-47890, CVE-2026-47884. -->
        <version>3.5.16</version>
        <relativePath/>
    </parent>
    <groupId>com.padle.core</groupId>
    <artifactId>padel-core-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>padel-core-service</name>
    <description>padel-core-service</description>

    <properties>
        <java.version>17</java.version>
        <org.mapstruct.version>1.6.3</org.mapstruct.version>
        <liquibase.version>4.30.0</liquibase.version>
        <commons-lang3.version>3.18.0</commons-lang3.version>
        <assertj.version>3.27.7</assertj.version>
        <!-- JWT версии -->
        <jjwt.version>0.12.6</jjwt.version>
        <!-- Tomcat: 10.1.54 → 10.1.61 (Boot 3.5.16 даёт только 10.1.55) для исправления:
             - CVE-2026-43515 (security constraints не применяются), CVE-2026-68525 (FORM auth),
               CVE-2026-65182, CVE-2026-41293 (HTTP/2 headers), CVE-2026-43512/65905 (DIGEST) — CRITICAL
             - CVE-2026-42498 (WebSocket auth header), CVE-2026-43513, CVE-2026-41284 — HIGH -->
        <tomcat.version>10.1.61</tomcat.version>
        <!-- Jackson: единая версия всех модулей через BOM Boot (раньше core/databind/annotations/jsr310
             были закреплены на 2.18.6, а остальные модули шли из BOM 2.21.x — смешанные версии).
             2.21.8 закрывает CVE-2026-54512/54513 (обход PolymorphicTypeValidator), CVE-2026-89425/89407/
             68494/68497/91776/91777 (DoS), CVE-2026-54514/77310 (SSRF) и др. -->
        <jackson-bom.version>2.21.8</jackson-bom.version>
        <!-- Log4j API (транзитивно через log4j-to-slf4j): 2.24.3 → 2.25.5, CVE-2026-49844 -->
        <log4j2.version>2.25.5</log4j2.version>
        <!-- Apache POI: 5.3.0 → 5.4.0 для исправления CVE в OOXML парсинге -->
        <poi.version>5.4.0</poi.version>
        <!-- PostgreSQL JDBC: 42.7.11 → 42.7.14, CVE-2026-54291 (даунгрейд channel binding) -->
        <postgresql.version>42.7.14</postgresql.version>
        <!-- Logback: 1.5.34 (Boot 3.5.16) → 1.5.38, последний патч ветки 1.5 -->
        <logback.version>1.5.38</logback.version>
        <!-- json-smart (транзитивно из spring-boot-starter-test): 2.5.2 → 2.6.0 -->
        <json-smart.version>2.6.0</json-smart.version>
        <!-- ASM (транзитивно через accessors-smart, Boot им не управляет): 9.7.1 → 9.11.1 -->
        <asm.version>9.11.1</asm.version>
    </properties>

    <dependencies>
        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.caceresenzo.disposableemaildomains</groupId>
            <artifactId>disposable-email-domains-spring-boot-starter</artifactId>
            <version>0.5.0</version>
        </dependency>

        <!-- OAuth2 Client -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>8.10.1</version>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.liquibase</groupId>
            <artifactId>liquibase-core</artifactId>
            <version>${liquibase.version}</version>
        </dependency>

        <!-- JWT для аутентификации -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- MapStruct -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${org.mapstruct.version}</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Guava Cache для отслеживания подозрительных IP -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.0.0-jre</version>
        </dependency>

        <!-- Dev Tools -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- ========== OBSERVABILITY ========== -->
        <!-- Prometheus metrics -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Loki log aggregation (JSON format for better indexing) -->
        <dependency>
            <groupId>com.github.loki4j</groupId>
            <artifactId>loki-logback-appender</artifactId>
            <version>1.5.2</version>
        </dependency>

        <!-- Spring AOP -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- For structured logging (JSON) -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.0</version>
        </dependency>

        <!-- Apache POI for Excel export (temporary) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <!-- Исключаем транзитивные зависимости с уязвимостями -->
            <exclusions>
                <exclusion>
                    <groupId>org.assertj</groupId>
                    <artifactId>assertj-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- MockMvc-проверки правил доступа через реальную цепочку фильтров (user(), csrf()) -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Явно добавляем безопасную версию AssertJ -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- Явно добавляем безопасную версию commons-lang3 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>${commons-lang3.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${org.mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Плагин для разрешения конфликтов версий -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-banned-dependencies</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <!-- Запрещаем уязвимые версии commons-lang -->
                                        <exclude>commons-lang:commons-lang:(,2.7]</exclude>
                                        <!-- Запрещаем уязвимые версии commons-lang3 -->
                                        <exclude>org.apache.commons:commons-lang3:(,3.18.0)</exclude>
                                        <!-- Запрещаем уязвимые версии AssertJ -->
                                        <exclude>org.assertj:assertj-core:(,3.27.7)</exclude>
                                        <!-- Запрещаем уязвимые версии Tomcat -->
                                        <exclude>org.apache.tomcat.embed:tomcat-embed-core:(,10.1.58)</exclude>
                                        <!-- Запрещаем уязвимые версии PostgreSQL JDBC -->
                                        <exclude>org.postgresql:postgresql:(,42.7.12)</exclude>
                                        <!-- Запрещаем уязвимые версии Thymeleaf (CVE-2026-41901) -->
                                        <exclude>org.thymeleaf:thymeleaf:(,3.1.5.RELEASE)</exclude>
                                        <!-- Запрещаем уязвимые версии Jackson -->
                                        <exclude>com.fasterxml.jackson.core:jackson-core:(,2.21.7)</exclude>
                                        <exclude>com.fasterxml.jackson.core:jackson-databind:(,2.21.7)</exclude>
                                        <!-- Запрещаем уязвимые версии Apache POI -->
                                        <exclude>org.apache.poi:poi-ooxml:(,5.4.0)</exclude>
                                    </excludes>
                                    <searchTransitive>true</searchTransitive>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Определение зависимостей управления версиями -->
    <dependencyManagement>
        <dependencies>
            <!-- Управляем версиями, которые могут быть транзитивными -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>

            <!-- Явно указываем версию Tomcat -->
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-core</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-el</artifactId>
                <version>${tomcat.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-websocket</artifactId>
                <version>${tomcat.version}</version>
            </dependency>

            <!-- ASM -->
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm</artifactId>
                <version>${asm.version}</version>
            </dependency>

            <!-- PostgreSQL JDBC Driver -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>

            <!-- Apache POI -->
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>${poi.version}</version>
            </dependency>

            <!-- Liquibase -->
            <dependency>
                <groupId>org.liquibase</groupId>
                <artifactId>liquibase-core</artifactId>
                <version>${liquibase.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>commons-lang</groupId>
                        <artifactId>commons-lang</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>