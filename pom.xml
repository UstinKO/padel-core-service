<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 3.5.16 → 4.1.2 (LFPT-0726): у Boot 3.5 закончилась OSS-поддержка, исправления Spring 6.2 /
             Security 6.5 / Data 2025.0 / Micrometer 1.15 больше не выходят. Boot 4.1 даёт Spring Framework 7.0,
             Security 7.1, Data 2026.0, Hibernate 7.4, Jackson 3.1, Tomcat 11, Micrometer 1.17.
             Версии Tomcat, Jackson, Thymeleaf, PostgreSQL JDBC, Logback, Log4j, json-smart, commons-lang3,
             AssertJ, Liquibase теперь берутся из BOM Boot — ручные пины LFPT-0725 не нужны. -->
        <version>4.1.2</version>
        <relativePath/>
    </parent>
    <groupId>com.padle.core</groupId>
    <artifactId>padel-core-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>padel-core-service</name>
    <description>padel-core-service</description>

    <properties>
        <java.version>17</java.version>
        <org.mapstruct.version>1.6.3</org.mapstruct.version>
        <!-- JWT версии -->
        <jjwt.version>0.13.0</jjwt.version>
        <!-- Apache POI: 5.3.0 → 5.4.0 для исправления CVE в OOXML парсинге -->
        <poi.version>5.4.0</poi.version>
        <!-- Новее, чем в BOM Boot 4.1.2 (LFPT-0726): Jackson 3.1.7 → 3.2.4, Logback 1.5.38 → 1.6.5 -->
        <jackson-bom.version>3.2.4</jackson-bom.version>
        <!-- BOM Jackson 2 в Boot импортируется раньше и задаёт jackson-annotations (общие для Jackson 2 и 3):
             поднимаем вместе, иначе Jackson 3.2 получает аннотации 2.21 (NoClassDefFoundError JsonApplyView).
             Самого Jackson 2 на classpath нет — см. enforcer. -->
        <jackson-2-bom.version>2.22.4</jackson-2-bom.version>
        <logback.version>1.6.5</logback.version>
    </properties>

    <dependencies>
        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.caceresenzo.disposableemaildomains</groupId>
            <artifactId>disposable-email-domains-spring-boot-starter</artifactId>
            <version>0.5.0</version>
        </dependency>

        <!-- OAuth2 Client -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-client</artifactId>
            <!-- json-smart ≤ 2.6.0 (последняя) — обход strict-проверки через 0x1A, фикса нет (LFPT-0726).
                 Тянется через oauth2-oidc-sdk, но в servlet-стеке Spring Security он нужен только для
                 discovery по issuer-uri (не используем) и WebFlux-классов; разбор ошибок Bearer
                 (OAuth2ErrorResponseErrorHandler) работает без него — проверено вход Google на фейковом провайдере. -->
            <exclusions>
                <exclusion>
                    <groupId>net.minidev</groupId>
                    <artifactId>json-smart</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>8.10.1</version>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Boot 4: автоконфигурация Liquibase вынесена в отдельный модуль -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-liquibase</artifactId>
        </dependency>

        <!-- JWT для аутентификации -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <!-- JSON для jjwt через Gson: jjwt-jackson тянул Jackson 2 — второй стек Jackson рядом с Jackson 3 Boot 4 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-gson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- MapStruct -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
            <version>${org.mapstruct.version}</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Guava Cache для отслеживания подозрительных IP -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.0.0-jre</version>
        </dependency>

        <!-- Dev Tools -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- ========== OBSERVABILITY ========== -->
        <!-- Prometheus metrics -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Loki log aggregation (JSON format for better indexing) -->
        <dependency>
            <groupId>com.github.loki4j</groupId>
            <artifactId>loki-logback-appender</artifactId>
            <version>2.1.0</version>
        </dependency>

        <!-- Spring AOP (Boot 4: spring-boot-starter-aop → spring-boot-starter-aspectj) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <!-- Apache POI for Excel export (temporary) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
            <!-- json-smart исключён (см. выше); json-path в тестах работает через Gson —
                 провайдер ставит JsonPathGsonDefaults (LauncherSessionListener) -->
            <exclusions>
                <exclusion>
                    <groupId>net.minidev</groupId>
                    <artifactId>json-smart</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Boot 4: @AutoConfigureMockMvc вынесен в модуль webmvc-test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- MockMvc-проверки правил доступа через реальную цепочку фильтров (user(), csrf()) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${org.mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>0.2.0</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Плагин для разрешения конфликтов версий -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-banned-dependencies</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <!-- Запрещаем уязвимые версии commons-lang -->
                                        <exclude>commons-lang:commons-lang:(,2.7]</exclude>
                                        <!-- Запрещаем уязвимые версии commons-lang3 -->
                                        <exclude>org.apache.commons:commons-lang3:(,3.18.0)</exclude>
                                        <!-- Запрещаем уязвимые версии AssertJ -->
                                        <exclude>org.assertj:assertj-core:(,3.27.7)</exclude>
                                        <!-- Запрещаем уязвимые версии Tomcat -->
                                        <exclude>org.apache.tomcat.embed:tomcat-embed-core:(,11.0.25)</exclude>
                                        <!-- Запрещаем уязвимые версии PostgreSQL JDBC -->
                                        <exclude>org.postgresql:postgresql:(,42.7.12)</exclude>
                                        <!-- Запрещаем уязвимые версии Thymeleaf (CVE-2026-41901) -->
                                        <exclude>org.thymeleaf:thymeleaf:(,3.1.5.RELEASE)</exclude>
                                        <!-- Jackson 2 не нужен: в Boot 4 используется Jackson 3 (tools.jackson) -->
                                        <exclude>com.fasterxml.jackson.core:jackson-core</exclude>
                                        <exclude>com.fasterxml.jackson.core:jackson-databind</exclude>
                                        <!-- json-smart ≤ 2.6.0: обход strict-валидации через 0x1A, исправленной версии нет -->
                                        <exclude>net.minidev:json-smart</exclude>
                                        <!-- Запрещаем уязвимые версии Apache POI -->
                                        <exclude>org.apache.poi:poi-ooxml:(,5.4.0)</exclude>
                                    </excludes>
                                    <searchTransitive>true</searchTransitive>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Определение зависимостей управления версиями -->
    <dependencyManagement>
        <dependencies>
            <!-- Apache POI -->
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>${poi.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>