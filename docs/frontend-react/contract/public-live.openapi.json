{
  "openapi": "3.1.0",
  "info": {
    "title": "Публичные live-снимки UI v2",
    "version": "1.0.0"
  },
  "paths": {
    "/api/public/events/{eventId}/live": {
      "get": {
        "summary": "Чтение публичного live-состояния",
        "security": [],
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Публичный неизменяемый снимок; Cache-Control: no-store",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "404": {
            "description": "Нет публичного события",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Другой формат или устаревший инстанс; canonicalUrl",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Некорректный ID",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Превышена квота; Retry-After",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Источник данных недоступен",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      },
      "head": {
        "summary": "Те же проверки и заголовки без тела",
        "security": [],
        "parameters": [
          {
            "name": "eventId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Публичный неизменяемый снимок; Cache-Control: no-store"
          },
          "404": {
            "description": "Нет публичного события"
          },
          "409": {
            "description": "Другой формат или устаревший инстанс; canonicalUrl"
          },
          "422": {
            "description": "Некорректный ID"
          },
          "429": {
            "description": "Превышена квота; Retry-After"
          },
          "503": {
            "description": "Источник данных недоступен"
          }
        }
      }
    },
