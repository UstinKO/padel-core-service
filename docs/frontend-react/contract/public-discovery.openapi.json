{
  "openapi": "3.1.0",
  "info": {
    "title": "Публичные данные UI v2",
    "version": "1.0.0",
    "description": "Только чтение. Мобильные /api/public/tournaments и /{id} сохраняют прежние ответы."
  },
  "paths": {
    "/api/public/catalog": {
      "get": {
        "summary": "Каталог без черновиков и мероприятий только по ссылке",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "maximum": 2147483647
            },
            "description": "Номер страницы с нуля. Смещение page × size не должно превышать 2147483647 (предел JPA); превышение возвращает 400 INVALID_CATALOG_FILTER."
          },
          {
            "name": "size",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 12
            },
            "description": "Размер страницы. Ограничение смещения page × size <= 2147483647 применяется совместно с page."
          },
          {
            "name": "clubId",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "KING_OF_COURT",
                "AMERICANO",
                "AMERICANO_TEAMS",
                "CANCHA_ABIERTA",
                "PADEL_CLINIC"
              ]
            }
          },
          {
            "name": "modality",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "INDIVIDUAL",
                "DOBLES"
              ]
            }
          },
          {
            "name": "gender",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "MASCULINO",
                "FEMENINO",
                "MIXTO"
              ]
            }
          },
          {
            "name": "level",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "BORRADOR",
                "PUBLICADO",
                "REGISTRO_ABIERTO",
                "CERRADO",
                "FINALIZADO",
                "CANCELADO"
              ]
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Данные публичного чтения",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogPage"
                }
              }
            }
          },
          "400": {
            "description": "Некорректные параметры, включая смещение page × size > 2147483647; код INVALID_CATALOG_FILTER.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Ресурс не найден",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Данные временно недоступны",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/public/home": {
      "get": {
        "summary": "Предстоящие опубликованные мероприятия и реальные счётчики",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Данные публичного чтения",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Home"
                }
              }
            }
          },
          "400": {
            "description": "Некорректные параметры",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Ресурс не найден",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Данные временно недоступны",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/public/clubs": {
      "get": {
        "summary": "Активные клубы",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Данные публичного чтения",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Club"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Некорректные параметры",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Ресурс не найден",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Данные временно недоступны",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/public/clubs/{id}": {
      "get": {
        "summary": "Публичная карточка активного клуба",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Данные публичного чтения",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Club"
                }
              }
            }
          },
          "400": {
            "description": "Некорректные параметры",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Ресурс не найден",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Данные временно недоступны",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Tournament": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "club": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "format": "int64"
              },
              "name": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "address": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "address"
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "KING_OF_COURT",
              "AMERICANO",
              "AMERICANO_TEAMS",
              "CANCHA_ABIERTA",
              "PADEL_CLINIC"
            ]
          },
          "modality": {
            "type": "string",
            "enum": [
              "INDIVIDUAL",
              "DOBLES"
            ]
          },
          "gender": {
            "type": "string",
            "enum": [
              "MASCULINO",
              "FEMENINO",
              "MIXTO"
            ]
          },
          "level": {
            "type": [
              "string",
              "null"
            ]
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "timeZone": {
            "type": "string"
          },
          "duration": {
            "type": [
              "string",
              "null"
            ]
          },
          "price": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "BORRADOR",
              "PUBLICADO",
              "REGISTRO_ABIERTO",
              "CERRADO",
              "FINALIZADO",
              "CANCELADO"
            ]
          },
          "registrationOpen": {
            "type": "boolean"
          },
          "capacity": {
            "type": "integer"
          },
          "capacityUnit": {
            "type": "string",
            "enum": [
              "PLAYERS",
              "PAIRS"
            ]
          },
          "occupied": {
            "type": "integer"
          },
          "available": {
            "type": "integer"
          },
          "waitlistCount": {
            "type": "integer"
          },
          "cancellationDeadline": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "websiteUrl": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "club",
          "type",
          "modality",
          "gender",
          "level",
          "startsAt",
          "timeZone",
          "duration",
          "price",
          "currency",
          "status",
          "registrationOpen",
          "capacity",
          "capacityUnit",
          "occupied",
          "available",
          "waitlistCount",
          "cancellationDeadline",
          "description",
          "websiteUrl"
        ]
      },
      "Club": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "city": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "logoUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "mapUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "websiteUrl": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "address",
          "city",
          "description",
          "logoUrl",
          "mapUrl",
          "websiteUrl"
        ]
      },
      "CatalogPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tournament"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer"
          }
        },
        "required": [
          "items",
          "page",
          "size",
          "totalElements",
          "totalPages"
        ]
      },
      "Home": {
        "type": "object",
        "properties": {
          "totalClubs": {
            "type": "integer",
            "format": "int64"
          },
          "totalPlayers": {
            "type": "integer",
            "format": "int64"
          },
          "totalTournaments": {
            "type": "integer",
            "format": "int64"
          },
          "upcomingTournaments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tournament"
            }
          }
        },
        "required": [
          "totalClubs",
          "totalPlayers",
          "totalTournaments",
          "upcomingTournaments"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "detail",
          "status",
          "instance",
          "code"
        ]
      }
    }
  }
}
