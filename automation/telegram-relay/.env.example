# Значения задаёт оператор на выделенном воркере, не в публичном репозитории.
TELEGRAM_BOT_TOKEN=
ALLOWED_CHAT_ID=
ALLOWED_THREAD_ID=
ARCHITECT_USER_ID=
CUSTOMER_USER_IDS=
GITHUB_REPO=UstinKO/padel-core-service
GITHUB_TOKEN_RO=
# Отдельная авторизация gh для push, issue и PR; не передавайте read-only token как GH_TOKEN.
GH_TOKEN=
CODEX_REPOSITORY=https://github.com/UstinKO/padel-core-service.git
CODEX_BINARY=codex
CODEX_SPOOL_DIR=/var/lib/padel-codex/jobs
CODEX_TIMEOUT_SECONDS=6000
MAX_PARALLEL=1
RELAY_STATE_FILE=/var/lib/padel-codex/state.json
ENGINE_DB=/var/lib/padel-codex/engine.db
# Только локальный сокет узкого моста; секрет API остаётся на хосте.
PIPELINE_STATUS_SOCKET=/run/padel-codex-switch/status.sock
DB_URL=jdbc:postgresql://postgres:5432/padel_codex_test
DB_USERNAME=padel_codex
DB_PASSWORD=
