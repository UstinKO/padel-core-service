{
  "version": "3.8",
  "services": {
    "preview-db": {
      "image": "${postgres}",
      "networks": [
        "private"
      ],
      "deploy": {
        "replicas": 1,
        "labels": {
          "com.padel.swarm-lab": "true"
        },
        "update_config": {
          "parallelism": 1,
          "order": "stop-first"
        },
        "rollback_config": {
          "parallelism": 1,
          "order": "stop-first"
        },
        "restart_policy": {
          "condition": "any",
          "delay": "5s"
        },
        "resources": {
          "limits": {
            "memory": "384M"
          },
          "reservations": {
            "memory": "16M"
          }
        }
      },
      "environment": {
        "POSTGRES_DB": "padel_ui_v2_preview",
        "POSTGRES_USER": "preview",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/database_password"
      },
      "secrets": [
        "database_password",
        "instance_id"
      ],
      "configs": [
        {
          "source": "init_db",
          "target": "/docker-entrypoint-initdb.d/preview.sql"
        }
      ],
      "volumes": [
        "database:/var/lib/postgresql/data"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U preview -d padel_ui_v2_preview"
        ],
        "interval": "5s",
        "timeout": "3s",
        "retries": 30
      }
    },
    "preview-mail": {
      "image": "${mailpit}",
      "networks": [
        "private"
      ],
      "deploy": {
        "replicas": 1,
        "labels": {
          "com.padel.swarm-lab": "true"
        },
        "update_config": {
          "parallelism": 1,
          "order": "stop-first"
        },
        "rollback_config": {
          "parallelism": 1,
          "order": "stop-first"
        },
        "restart_policy": {
          "condition": "any",
          "delay": "5s"
        },
        "resources": {
          "limits": {
            "memory": "96M"
          },
          "reservations": {
            "memory": "16M"
          }
        }
      }
    },
    "padel-app": {
      "image": "${app}",
      "networks": [
        "web",
        "private",
        "events"
      ],
      "deploy": {
        "replicas": 1,
        "labels": {
          "com.padel.swarm-lab": "true"
        },
        "update_config": {
          "parallelism": 1,
          "order": "stop-first"
        },
        "rollback_config": {
          "parallelism": 1,
          "order": "stop-first"
        },
        "restart_policy": {
          "condition": "any",
          "delay": "5s"
        },
        "resources": {
          "limits": {
            "memory": "896M"
          },
          "reservations": {
            "memory": "16M"
          }
        }
      },
      "environment": {
        "SPRING_PROFILES_ACTIVE": "preview",
        "APP_BASE_URL": "http://127.0.0.1:18080",
        "APP_PREVIEW_REVISION": "${revision}",
        "JAVA_TOOL_OPTIONS": "-Xms128m -Xmx512m",
        "MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE": "health,prometheus",
        "MANAGEMENT_PROMETHEUS_METRICS_EXPORT_ENABLED": "true"
      },
      "secrets": [
        {
          "source": "database_password",
          "target": "spring.datasource.password",
          "uid": "10001",
          "gid": "10001",
          "mode": 256
        },
        {
          "source": "instance_id",
          "target": "app.preview.instance-id",
          "uid": "10001",
          "gid": "10001",
          "mode": 256
        },
        {
          "source": "fixture_password",
          "target": "app.preview.fixture-password",
          "uid": "10001",
          "gid": "10001",
          "mode": 256
        },
        {
          "source": "jwt_secret",
          "target": "jwt.secret",
          "uid": "10001",
          "gid": "10001",
          "mode": 256
        },
        {
          "source": "rest_peer_key",
          "target": "cluster-events-key",
          "uid": "10001",
          "gid": "10001",
          "mode": 256
        }
      ],
      "stop_grace_period": "40s",
      "healthcheck": {
        "test": [
          "CMD",
          "bash",
          "-c",
          "exec 3<>/dev/tcp/127.0.0.1/8080; printf 'GET /actuator/health/readiness HTTP/1.0\\r\\nHost: localhost\\r\\n\\r\\n' >&3; head -1 <&3 | grep -q ' 200 '"
        ],
        "interval": "10s",
        "timeout": "5s",
        "retries": 3,
        "start_period": "120s"
      }
    },
    "redis": {
      "image": "${redis}",
      "networks": [
        "private"
      ],
      "deploy": {
        "replicas": 1,
        "labels": {
          "com.padel.swarm-lab": "true"
        },
        "update_config": {
          "parallelism": 1,
          "order": "stop-first"
        },
        "rollback_config": {
          "parallelism": 1,
          "order": "stop-first"
        },
        "restart_policy": {
          "condition": "any",
          "delay": "5s"
        },
        "resources": {
          "limits": {
            "memory": "128M"
          },
          "reservations": {
            "memory": "16M"
          }
        }
      },
      "command": [
        "sh",
        "-ec",
        "exec redis-server --maxmemory 64mb --maxmemory-policy noeviction --requirepass \"$$(cat /run/secrets/redis_password)\""
      ],
      "secrets": [
        "redis_password"
      ],
      "volumes": [
        "redis:/data"
      ]
    },
    "gateway": {
      "image": "${nginx}",
      "networks": [
        "edge",
        "web",
        "private"
      ],
      "deploy": {
        "replicas": 1,
        "labels": {
          "com.padel.swarm-lab": "true"
        },
        "update_config": {
          "parallelism": 1,
          "order": "stop-first"
        },
        "rollback_config": {
          "parallelism": 1,
          "order": "stop-first"
        },
        "restart_policy": {
          "condition": "any",
          "delay": "5s"
        },
        "resources": {
          "limits": {
            "memory": "64M"
          },
          "reservations": {
            "memory": "16M"
          }
        }
      },
      "configs": [
        {
          "source": "nginx",
          "target": "/etc/nginx/conf.d/default.conf"
        }
      ],
      "secrets": [
        {
          "source": "tls_certificate",
          "target": "lab.crt",
          "uid": "0",
          "gid": "0",
          "mode": 256
        },
        {
          "source": "tls_key",
          "target": "lab.key",
          "uid": "0",
          "gid": "0",
          "mode": 256
        }
      ],
      "ports": [
        {
          "target": 80,
          "published": 80,
          "protocol": "tcp",
          "mode": "host"
        },
        {
          "target": 443,
          "published": 443,
          "protocol": "tcp",
          "mode": "host"
        }
      ]
    },
    "prometheus": {
      "image": "${prometheus}",
      "networks": [
        "private"
      ],
      "deploy": {
        "replicas": 1,
        "labels": {
          "com.padel.swarm-lab": "true"
        },
        "update_config": {
          "parallelism": 1,
          "order": "stop-first"
        },
        "rollback_config": {
          "parallelism": 1,
          "order": "stop-first"
        },
        "restart_policy": {
          "condition": "any",
          "delay": "5s"
        },
        "resources": {
          "limits": {
            "memory": "192M"
          },
          "reservations": {
            "memory": "16M"
          }
        }
      },
      "configs": [
        {
          "source": "prometheus",
          "target": "/etc/prometheus/prometheus.yml"
        }
      ],
      "volumes": [
        "prometheus:/prometheus"
      ],
      "command": [
        "--config.file=/etc/prometheus/prometheus.yml",
        "--storage.tsdb.retention.time=2d"
      ]
    },
    "loki": {
      "image": "${loki}",
      "networks": [
        "private"
      ],
      "deploy": {
        "replicas": 1,
        "labels": {
          "com.padel.swarm-lab": "true"
        },
        "update_config": {
          "parallelism": 1,
          "order": "stop-first"
        },
        "rollback_config": {
          "parallelism": 1,
          "order": "stop-first"
        },
        "restart_policy": {
          "condition": "any",
          "delay": "5s"
        },
        "resources": {
          "limits": {
            "memory": "128M"
          },
          "reservations": {
            "memory": "16M"
          }
        }
      },
      "volumes": [
        "loki:/loki"
      ],
      "command": [
        "-config.file=/etc/loki/local-config.yaml"
      ]
    },
    "grafana": {
      "image": "${grafana}",
      "networks": [
        "private"
      ],
      "deploy": {
        "replicas": 1,
        "labels": {
          "com.padel.swarm-lab": "true"
        },
        "update_config": {
          "parallelism": 1,
          "order": "stop-first"
        },
        "rollback_config": {
          "parallelism": 1,
          "order": "stop-first"
        },
        "restart_policy": {
          "condition": "any",
          "delay": "5s"
        },
        "resources": {
          "limits": {
            "memory": "128M"
          },
          "reservations": {
            "memory": "16M"
          }
        }
      },
      "environment": {
        "GF_SECURITY_ADMIN_USER": "lab",
        "GF_SECURITY_ADMIN_PASSWORD__FILE": "/run/secrets/grafana_password",
        "GF_AUTH_ANONYMOUS_ENABLED": "false"
      },
      "secrets": [
        "grafana_password"
      ],
      "volumes": [
        "grafana:/var/lib/grafana"
      ],
      "configs": [
        {
          "source": "datasources",
          "target": "/etc/grafana/provisioning/datasources/lab.yml"
        }
      ]
    }
  },
  "networks": {
    "edge": {
      "driver": "overlay"
    },
    "web": {
      "driver": "overlay",
      "internal": true
    },
    "private": {
      "driver": "overlay",
      "internal": true,
      "attachable": true
    },
    "events": {
      "driver": "overlay",
      "internal": true
    }
  },
  "volumes": {
    "database": {},
    "redis": {},
    "prometheus": {},
    "loki": {},
    "grafana": {}
  },
  "secrets": {
    "database_password": {
      "file": "/lab/runtime/database_password"
    },
    "instance_id": {
      "file": "/lab/runtime/instance_id"
    },
    "fixture_password": {
      "file": "/lab/runtime/fixture_password"
    },
    "jwt_secret": {
      "file": "/lab/runtime/jwt_secret"
    },
    "redis_password": {
      "file": "/lab/runtime/redis_password"
    },
    "grafana_password": {
      "file": "/lab/runtime/grafana_password"
    },
    "tls_certificate": {
      "file": "/lab/runtime/tls_certificate"
    },
    "tls_key": {
      "file": "/lab/runtime/tls_key"
    },
    "rest_peer_key": {
      "file": "/lab/runtime/rest_peer_key"
    }
  },
  "configs": {
    "init_db": {
      "file": "/lab/init-db.sql"
    },
    "nginx": {
      "file": "/lab/nginx.conf"
    },
    "prometheus": {
      "file": "/lab/prometheus.yml"
    },
    "datasources": {
      "file": "/lab/datasources.yml"
    }
  }
}
