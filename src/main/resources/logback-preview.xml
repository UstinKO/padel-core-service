<configuration>
    <conversionRule conversionWord="mask" class="com.padle.core.padelcoreservice.logging.MaskingConverter"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>%d{HH:mm:ss} %-5level %logger{36} - %mask%n%ex</pattern></encoder>
    </appender>
    <root level="INFO"><appender-ref ref="CONSOLE"/></root>
</configuration>
